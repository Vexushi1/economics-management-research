{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vexushi1/economics-management-research/schemas/research-state.schema.json",
  "title": "Research state snapshot (schema v1; backward-compatible Phase 1 consolidation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "research_type",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "research_type": {
      "type": "string",
      "enum": [
        "analytical_game",
        "stochastic_operations",
        "empirical_econometrics",
        "hybrid",
        "replication"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256",
          "schema_version",
          "created_by",
          "created_at",
          "status"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "created_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "VALID",
              "STALE",
              "REVOKED"
            ]
          }
        }
      },
      "maxItems": 20000
    },
    "research_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workflow_nodes": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "skill_name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "skill_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "READY",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "BLOCKED",
              "STALE",
              "SKIPPED"
            ]
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "uniqueItems": true
          },
          "output_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "uniqueItems": true
          }
        }
      }
    },
    "artifact_dependencies": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parent",
          "child"
        ],
        "properties": {
          "parent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "child": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    }
  },
  "description": "Validated, inert metadata. No expressions or external references are executed."
}
